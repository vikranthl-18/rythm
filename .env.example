# rythm — environment variables (copy to .env.local and fill in)
# IMPORTANT: never commit real values here. .env.local is gitignored.

# Google OAuth client ID for "Sign in with Google" (Google Identity Services).
# Create one at https://console.cloud.google.com/apis/credentials
#   - Authorized JavaScript origins: your deployed origin (https://your-app.com)
#     AND http://localhost:5173 (dev). If the origin isn't listed, the Google
#     button falls back to the offline demo chooser.
#   - Authorized redirect URIs: not needed for the GIS button/one-tap flow
# When this is empty, the app runs in demo mode: the Google button opens an
# offline account chooser, and email/password accounts are stored locally.
VITE_GOOGLE_CLIENT_ID=YOUR_CLIENT_ID.apps.googleusercontent.com

# Comma-separated list of origins the Google client ID is authorized for
# (must match "Authorized JavaScript origins" in Google Cloud Console). When
# set, the app checks the current origin against this list: if the origin
# isn't listed, the real Google button is NOT rendered (it would fail with
# "Error 400: invalid_request" in the popup) — instead the app shows the fix
# instructions + the offline demo chooser. Include the trailing-slash-less
# origin exactly, e.g. http://localhost:5173,https://your-app.com
VITE_AUTHORIZED_ORIGINS=http://localhost:5173

# Optional: Leaflet tile provider URL template (defaults to OSM public tiles).
# VITE_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png

# ---- Cloud sync (opt-in, real accounts) -------------------------------------
# Set both to turn on Supabase: real email/Google accounts (Google tokens are
# verified server-side by Supabase Auth), and the "Cloud sync" toggle in
# Settings that backs up metrics/workouts/habits to the cloud. Local-first
# stays the default — without these, everything runs fully in the browser.
#
# Setup:
#   1. Create a project at https://supabase.com
#   2. Run supabase/migrations/0001_init.sql (Dashboard → SQL Editor) — creates
#      profiles + user_snapshots tables with row-level security (each user
#      only touches their own rows).
#   3. Auth → Providers → enable Google, callback URL
#      https://<project-ref>.supabase.co/auth/v1/callback
#   4. Paste the project URL and anon key below.
# VITE_SUPABASE_URL=https://<project-ref>.supabase.co
# VITE_SUPABASE_ANON_KEY=your-anon-key

# ---- AI Coach ---------------------------------------------------------------
# The coach resolves providers in this order:
#   1. VITE_COACH_API  -> your deployed serverless function (api/coach.ts).
#                         The model key lives server-side on the platform —
#                         this is the production path.
#   2. VITE_GEMINI_API_KEY -> direct client call to Google Gemini (dev path).
#                         The key ships in the bundle; restrict it by HTTP
#                         referrer in Google Cloud Console and prefer path 1
#                         for production.
#   3. Neither set     -> built-in deterministic engine (fully offline).
#
# URL of your deployed serverless coach function (deploy api/coach.ts).
# VITE_COACH_API=https://your-app.vercel.app/api/coach
# Optional: bearer token the app sends; must match COACH_API_TOKEN on the function.
# VITE_COACH_API_TOKEN=

# Direct Gemini key (dev path — see ordering above).
# VITE_GEMINI_API_KEY=YOUR_GEMINI_API_KEY
# Optional: model for the direct path (default gemini-2.5-flash).
# VITE_GEMINI_MODEL=gemini-2.5-flash

# ---- Crash / error monitoring (Sentry) ------------------------------------
# Optional. When set, uncaught errors + rejections are reported to Sentry
# (in addition to the built-in in-app crash screen). Health data is stripped
# before anything leaves the device. Get a DSN from https://sentry.io →
# your project → Client Keys (DSN). When unset, nothing is sent.
# VITE_SENTRY_DSN=https://xxxx@o123456.ingest.sentry.io/1234567

# ---- Transactional email ---------------------------------------------------
# Sends emails (welcome on sign-up, plus digest/requests/milestones) through
# the api/mail.ts serverless function. Without these, no emails are sent and
# the app is unaffected.
#   Setup: create a project at https://resend.com, add + verify your domain
#   (or just verify your own address for the sandbox), then set the env vars
#   below on the platform and VITE_MAIL_API in .env.local.
# URL of your deployed mail function (deploy api/mail.ts).
# VITE_MAIL_API=https://your-app.vercel.app/api/mail
# Optional: bearer token the app sends; must match MAIL_API_TOKEN on the function.
# VITE_MAIL_API_TOKEN=

# ---- Function-side env (set on the serverless platform, NEVER in the client) --
# LLM_PROVIDER=openai            # or anthropic | gemini
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-3-5-haiku-latest
# GEMINI_API_KEY=YOUR_GEMINI_API_KEY
# GEMINI_MODEL=gemini-2.5-flash
# COACH_API_TOKEN=some-secret-token

# ---- Email function-side env (set on the serverless platform) -----------------
# RESEND_API_KEY=re_...          # required — https://resend.com/api-keys
# MAIL_FROM=rythm <hi@your-app.com>  # verified sender; defaults to Resend's sandbox
# MAIL_API_TOKEN=some-secret-token   # optional; must match VITE_MAIL_API_TOKEN
