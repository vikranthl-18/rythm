[TEMPLATE]
# rythm native — copy to .env and fill in (never commit .env).
# Use the SAME Supabase project as the web app. Expo embeds EXPO_PUBLIC_*
# values at build time; they are visible to the app but the anon key is
# public by design — RLS keeps each user to their own rows.

# The deployed web app — the "App" tab embeds this. Set it to your Vercel
# URL once the web app is live (e.g. https://rythm.vercel.app). Until then
# the shell shows a "point me at it" screen; health reads still work.
EXPO_PUBLIC_WEB_URL=

EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional: Sentry crash reporting (DSN from https://sentry.io → your project
# → Client Keys). Must also be mirrored in eas.json preview.env for EAS
# builds. When unset, crash reporting is a silent no-op.
EXPO_PUBLIC_SENTRY_DSN=
